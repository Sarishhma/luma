{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "outDir": "./dist",
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "strict": true,

    "types": ["vite/client"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "skipLibCheck": true,
    "esModuleInterop": true
  },

  "include": ["src"]
}